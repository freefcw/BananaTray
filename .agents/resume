#!/usr/bin/env bash
# Orb resume for BananaTray — fast, idempotent reconnect/repair run on every
# orb wake. Target completion: a few seconds. Never installs dependencies here.
set -euo pipefail

log() { printf '\033[1;34m[resume]\033[0m %s\n' "$*"; }

# Make cargo + just available in this shell (setup already added them to
# ~/.profile / ~/.bashrc for fresh login shells).
# shellcheck disable=SC1090
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
case ":${PATH:-}:" in
  *":$HOME/.local/bin:"*) : ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

status=0
command -v cargo >/dev/null 2>&1 || { log "warning: cargo not on PATH"; status=1; }
command -v just  >/dev/null 2>&1 || { log "warning: just not on PATH";  status=1; }

# BananaTray has no long-lived dev server or database to restart; the cargo
# registry/target cache and apt packages persist across orb wake. A warm orb
# needs nothing further, so we just confirm the toolchain is reachable.
if [ "$status" -eq 0 ]; then
  log "toolchain ready ($(cargo --version 2>&1))"
fi

exit "$status"
